# Content Factory production environment example
# Copy this file to /opt/content-factory/.env and replace placeholders before first start.

### 应用基础
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

### OpenRouter / 模型调用（必须）
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini

### 长文/图片链（按当前功能建议一起配置）
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_IMAGE_ASPECT_RATIO=4:5
OPENROUTER_IMAGE_REVIEW_MODEL=openai/gpt-4.1-mini
LONGFORM_BRIEF_MODEL=openai/gpt-5-mini
LONGFORM_FINAL_MODEL=openai/gpt-5-mini

### 外部公众号爆款抓取（/topics/wechat-hot 必需）
EXTERNAL_WECHAT_API_KEY=replace-with-external-wechat-api-key
# 某些第三方平台需要 verifyCode，没有则留空
EXTERNAL_WECHAT_VERIFYCODE=
# 不填时走当前代码默认地址；如第三方平台要求自定义网关，再显式填写
EXTERNAL_WECHAT_BASE_URL=

### 头图 / 公开图片链（当前头图生成与部分发布链依赖，建议必配）
PUBLIC_IMAGE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=wechat-covers

### 提示词 / 语料 / SQLite
# 当前 SQLite 路径由代码固定为 /app/data/content-agent.sqlite，无需额外环境变量。
# 当前 uploads 目录建议挂载到 /app/uploads，作为服务器本地上传目录预留位。

### 发布链
# 这部分配置当前主要由设置页写入 SQLite。
# 如果你直接迁本地 data/content-agent.sqlite，上线后通常不用重新填写。
# 如果你准备在新服务器上全新初始化，再通过设置页补齐下面这些值：
#
# wechat_publish_api_key
# wechat_publish_base_url
# xiaohongshu_publish_api_key
# xiaohongshu_publish_base_url
# feishu_app_id
# feishu_app_secret
